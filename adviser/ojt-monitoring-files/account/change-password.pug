extends ../layouts/main

block content
  h1.page-title Change password
  if mustChange
    p.flash.flash-info You are using a temporary password. Choose your own password to continue.

  section.card.card-pad
    form.form(action='/adviser/account/password' method='POST')
      input(type='hidden' name='csrf_token' value=csrfToken)
      .field
        label(for='currentPassword') Current password
        input.input#currentPassword(type='password' name='currentPassword' autocomplete='current-password' required aria-invalid=(errors.currentPassword ? 'true' : undefined) aria-describedby=(errors.currentPassword ? 'currentPassword-error' : undefined))
        if errors.currentPassword
          span.error#currentPassword-error= errors.currentPassword
      .field
        label(for='newPassword') New password
        input.input#newPassword(type='password' name='newPassword' autocomplete='new-password' required aria-invalid=(errors.newPassword ? 'true' : undefined) aria-describedby='newPassword-help')
        span.help#newPassword-help At least 15 characters. A short sentence is easy to remember, like "blue tables walk slowly".
        if errors.newPassword
          span.error= errors.newPassword
      .field
        label(for='confirmPassword') Type the new password again
        input.input#confirmPassword(type='password' name='confirmPassword' autocomplete='new-password' required aria-invalid=(errors.confirmPassword ? 'true' : undefined) aria-describedby=(errors.confirmPassword ? 'confirmPassword-error' : undefined))
        if errors.confirmPassword
          span.error#confirmPassword-error= errors.confirmPassword
      .btn-row
        button.btn.btn-primary(type='submit') Change password