extends ../../layouts/main

include ../../partials/review-decision

block content
  p.crumb
    a(href='/adviser/interns') Interns
    |  / Weekly reports
  h1.page-title Weekly reports · #{intern.studentName}

  if notSent.length
    h2.section-title Not sent · #{notSent.length}
    section.card
      each missing in notSent
        article.item
          .item-head
            h3 Week #{missing.week} · #{missing.label}
            if missing.overdue
              span.tag.tag-bad Overdue
            else
              span.tag Not sent yet
          p.meta Due #{missing.dueLabel}, 12 noon
          details
            summary.link-btn Excuse week #{missing.week}
            form.form(action=`/adviser/interns/${internId}/weekly-reports/excuse` method='POST')
              input(type='hidden' name='csrf_token' value=csrfToken)
              input(type='hidden' name='week' value=missing.week)
              .field
                label(for=`excuse-${missing.week}`) Reason
                textarea.input(id=`excuse-${missing.week}` name='reason' rows='2' maxlength='255' required)
                span.help #{intern.studentName} won't need to send this week. Use it for holidays or company closures.
              .btn-row
                button.btn.btn-create.btn-sm(type='submit') Excuse week #{missing.week}

  h2.section-title Sent · #{weeklyReports.length}
  section.card
    if weeklyReports.length === 0
      .empty
        b No weekly reports yet
        | Reports show up here once the intern submits them.
    each report in weeklyReports
      article.item
        .item-head
          if report.kind === 'EXCUSED'
            h3 Week #{report.weeknumber} · Excused
          else if report.kind === 'NO_WORK'
            h3 Week #{report.weeknumber} · No work this week
          else
            h3 Week #{report.weeknumber} · #{report.hours} hours
          span
            if report.late
              span.tag.tag-bad Late
              = ' '
            if report.kind === 'EXCUSED'
              span.tag.tag-ok Excused
            else
              - const status = statusOf('review', report.status)
              span.tag(class=status.tag)= status.label
        if report.datesubmitted
          p.meta Submitted #{report.datesubmitted}#{report.supervisor_name ? ` · Supervisor: ${report.supervisor_name}` : ''}
        if report.late_letter_path
          p
            a(href=`/adviser/weekly-reports/${report.reportid}/late-letter`) View late letter
        if report.kind === 'EXCUSED'
          p.note
            b You excused this week:
            |  #{report.remark}
        if report.days.length
          .table-wrap
            table
              thead
                tr
                  th(scope='col') Date
                  th(scope='col') Morning
                  th(scope='col') Afternoon
                  th.num(scope='col') Hours
              tbody
                each day in report.days
                  tr
                    th(scope='row')= day.day
                    td= day.am_in ? `${day.am_in} – ${day.am_out}` : '–'
                    td= day.pm_in ? `${day.pm_in} – ${day.pm_out}` : '–'
                    td.num= day.hours
        if report.absences.length
          p
            b Absence report · #{report.absences.length} #{report.absences.length === 1 ? 'absence' : 'absences'}
          .table-wrap
            table
              thead
                tr
                  th(scope='col') Date
                  th(scope='col') Absent
                  th(scope='col') Reason
                  th(scope='col') Proof
              tbody
                each absence in report.absences
                  tr
                    th(scope='row')= absence.day
                    td= absence.part
                    td= absence.reason
                    td
                      a(href=`/adviser/weekly-reports/${report.reportid}/absences/${absence.date}/proof`)= absence.proof
        if report.kind === 'NO_WORK'
          p.note
            b Why: #{report.noWorkReason}.
            |  #{report.workdescription}
        else if report.workdescription
          p.note
            b Work accomplishment:
            |  #{report.workdescription}
        if report.file_path
          p
            a(href=`/adviser/weekly-reports/${report.reportid}/file`)= report.kind === 'NO_WORK' ? 'View proof' : 'View signed report'
        unless report.kind === 'EXCUSED'
          +reviewDecision(`/adviser/interns/${internId}/weekly-reports`, 'reportid', report.reportid, report.status, report.remark)
