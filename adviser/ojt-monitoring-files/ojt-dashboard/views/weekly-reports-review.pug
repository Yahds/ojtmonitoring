extends ../../layouts/main

block content
  p.crumb
    a(href='/adviser/interns') Interns
    |  / Weekly reports
  h1.page-title
    | Weekly reports
    if weeklyReports.length
      |  · #{weeklyReports[0].studentName}

  section.card
    if weeklyReports.length === 0
      .empty
        b No weekly reports yet
        | Reports show up here once the intern submits them.
    each report in weeklyReports
      article.item
        .item-head
          h3 Week #{report.weeknumber} · #{report.hours} hours
          span.tag(class={ APPROVED: 'tag-ok', REJECTED: 'tag-bad', SUBMITTED: 'tag-warn' }[report.status])= report.status
        if report.datesubmitted
          p.meta Submitted #{report.datesubmitted}
        if report.workdescription
          p.note= report.workdescription
        if report.file_path
          p
            a(href=`/adviser/weekly-reports/${report.reportid}/file`) View signed report
        form.form(action=`/adviser/interns/${internId}/weekly-reports` method='POST')
          input(type='hidden' name='csrf_token' value=csrfToken)
          input(type='hidden' name='reportid' value=report.reportid)
          .field
            label(for=`remark-${report.reportid}`) Your remark
            textarea.input(id=`remark-${report.reportid}` name='remark' rows='2')= report.remark
          .btn-row
            button.btn.btn-create.btn-sm(type='submit' name='decision' value='APPROVED') Approve
            button.btn.btn-reject.btn-sm(type='submit' name='decision' value='REJECTED') Reject
