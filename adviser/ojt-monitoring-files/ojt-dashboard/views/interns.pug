extends ../../layouts/main

block content
  h1.page-title Interns

  section.card
    .card-head
      h2 My interns
      a.btn.btn-create.btn-sm(href='#enroll') Enroll intern
    if interns.length === 0
      .empty
        b No interns yet
        | Enroll your first intern with the form below.
    else
      .table-wrap
        table
          thead
            tr
              th Name
              th Course
              th Company
              th Status
              th Review
              th Action
          tbody
            each i in interns
              tr
                td= i.studentName
                td= i.course
                td= i.companyname || '—'
                td
                  span.tag(class=(i.status === 'ACTIVE' ? 'tag-ok' : ''))= i.status
                td
                  .btn-row
                    a(href=`/ojt-dashboard/requirements-review/${i.internid}`) Requirements
                    a(href=`/ojt-dashboard/weekly-reports-review/${i.internid}`) Reports
                    a(href=`/ojt-dashboard/journals-review/${i.internid}`) Journals
                td
                  if i.status === 'PENDING'
                    form(action='/ojt-dashboard/deploy' method='POST')
                      input(type='hidden' name='csrf_token' value=csrfToken)
                      input(type='hidden' name='internID' value=i.internid)
                      button.btn.btn-create.btn-sm(type='submit') Deploy

  section.card.card-pad#enroll
    h2.section-title Enroll an intern
    form.form(action='/ojt-dashboard/enroll' method='POST')
      input(type='hidden' name='csrf_token' value=csrfToken)
      .field
        label(for='studentID') Student ID
        input.input#studentID(type='text' name='studentID' inputmode='numeric' required)
      .field
        label(for='name') Full name
        input.input#name(type='text' name='name' placeholder='Torres, Sam' required)
        span.help Last name, then first name.
      .field
        label(for='course') Course
        select.input#course(name='course' required)
          option(value='') Select a course
          option(value='BSIT') BSIT
          option(value='BSCS') BSCS
      .field
        label(for='year') Year
        input.input#year(type='text' name='year' inputmode='numeric' placeholder='4' required)
      .field
        label(for='classcode') Class code
        input.input#classcode(type='text' name='classcode' required)
      .field
        label(for='password') Temporary password
        input.input#password(type='text' name='password' autocomplete='off' required)
        span.help The student logs in with this. Share it with them privately.
      .btn-row
        button.btn.btn-create(type='submit') Enroll intern
