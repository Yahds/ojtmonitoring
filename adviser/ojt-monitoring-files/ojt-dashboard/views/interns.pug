meta(charset='UTF-8')
meta(name='viewport' content='width=device-width, initial-scale=1.0')
title Enroll Intern
style.
  body { font-family: system-ui, sans-serif; margin: 0; background: #eceae3; color: #2b2a33; }
  .navbar { display: flex; align-items: center; justify-content: space-between; background: #0d0464; color: #fff; padding: 12px 20px; border-bottom: 3px solid #e1ad0f; }
  .nav-logo { font-weight: 700; letter-spacing: .03em; }
  main { padding: 24px; max-width: 480px; }
  h1 { color: #0d0464; }
  a.back { color: #0d0464; text-decoration: none; font-weight: 600; }
  form.enroll { background: #fff; padding: 16px; border-radius: 8px; display: grid; gap: 10px; margin-top: 16px; }
  form.enroll label { font-size: 13px; font-weight: 600; color: #555; }
  form.enroll input, form.enroll select { padding: 8px; border: 1px solid #ccc; border-radius: 4px; width: 100%; box-sizing: border-box; }
  form.enroll button { background: #0d0464; color: #fff; padding: 10px; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; }
header
  nav.navbar
    .nav-logo SAINT LOUIS UNIVERSITY
    .nav-name #{adviser.adviserName.split(' ').reverse().join(' ').replace(',', '')} · Adviser
main
  a.back(href='/ojt-dashboard') ← Back to dashboard
  
  h1 Enroll Intern
  form.enroll(action='/ojt-dashboard/enroll' method='POST')
    label Student ID (SLU number)
    input(type='text' name='studentID' required)
    label Full name
    input(type='text' name='name' placeholder='e.g. Torres, Sam' required)
    label Course
    select(name='course' required)
      option(value='') — select —
      option(value='BSIT') BSIT
      option(value='BSCS') BSCS
    label Year
    input(type='text' name='year' placeholder='e.g. 4' required)
    label Class code
    input(type='text' name='classcode' required)
    label Temporary password
    input(type='text' name='password' required)
    button(type='submit') Enroll intern
  h2 Interns
  table
    tr
      th Name
      th Course
      th Status
    each i in interns
      tr
        td #{i.studentName}
        td #{i.course}
        td #{i.status}
    if interns.length === 0
      tr
        td(colspan='3') No interns yet.
