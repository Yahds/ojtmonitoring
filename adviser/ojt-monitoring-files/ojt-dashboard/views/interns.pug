extends ../../layouts/main

block content
  h1.page-title Interns

  section.card
    .card-head
      h2 My interns
      a.btn.btn-create.btn-sm(href='#enroll') Enroll intern
    if interns.length === 0
      .empty
        b No interns yet
        | Enroll your first intern with the form below.
    else
      .table-wrap
        table
          thead
            tr
              th Name
              th Course
              th Company
              th Status
              th Review
              th Action
          tbody
            each i in interns
              tr
                td= i.studentName
                td= i.course
                td= i.companyname || '—'
                td
                  - const status = statusOf('intern', i.status)
                  span.tag(class=status.tag)= status.label
                td
                  .btn-row
                    a(href=`/adviser/interns/${i.internid}/requirements`) Requirements
                    a(href=`/adviser/interns/${i.internid}/weekly-reports`) Reports
                    a(href=`/adviser/interns/${i.internid}/journals`) Journals
                td
                  if i.status === 'PENDING'
                    form(action=`/adviser/interns/${i.internid}/deploy` method='POST')
                      input(type='hidden' name='csrf_token' value=csrfToken)
                      button.btn.btn-create.btn-sm(type='submit') Deploy

  section.card.card-pad#enroll
    h2.section-title Enroll an intern
    form.form(action='/adviser/interns' method='POST')
      input(type='hidden' name='csrf_token' value=csrfToken)
      .field
        label(for='studentID') Student ID
        input.input#studentID(type='text' name='studentID' inputmode='numeric' value=values.studentID required aria-invalid=(errors.studentID ? 'true' : undefined) aria-describedby=(errors.studentID ? 'studentID-error' : undefined))
        if errors.studentID
          span.error#studentID-error= errors.studentID
      .field
        label(for='name') Full name
        input.input#name(type='text' name='name' placeholder='Torres, Sam' value=values.name required)
        span.help Last name, then first name.
      .field
        label(for='course') Course
        select.input#course(name='course' required)
          option(value='') Select a course
          option(value='BSIT' selected=values.course === 'BSIT') BSIT
          option(value='BSCS' selected=values.course === 'BSCS') BSCS
      .field
        label(for='year') Year
        input.input#year(type='text' name='year' inputmode='numeric' placeholder='4' value=values.year required)
      .field
        label(for='classcode') Class code
        input.input#classcode(type='text' name='classcode' value=values.classcode required)
      .field
        label(for='email') SLU email
        input.input#email(type='email' name='email' autocomplete='off' value=values.email required aria-invalid=(errors.email ? 'true' : undefined) aria-describedby=(errors.email ? 'email-error' : 'email-help'))
        if errors.email
          span.error#email-error= errors.email
        else
          span.help#email-help The student signs in with this account.
      .btn-row
        button.btn.btn-create(type='submit') Enroll intern
