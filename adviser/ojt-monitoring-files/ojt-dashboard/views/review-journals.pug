extends ../../layouts/main

block content
  p.crumb
    a(href='/ojt-dashboard/enroll') Interns
    |  / Monthly journals
  h1.page-title
    | Monthly journals
    if journals.length
      |  · #{journals[0].studentName}

  section.card
    if journals.length === 0
      .empty
        b No journals yet
        | Journals show up here once the intern submits them.
    each journal in journals
      article.item
        .item-head
          h3 Month #{journal.monthnumber}
          span.tag(class={ APPROVED: 'tag-ok', REJECTED: 'tag-bad', SUBMITTED: 'tag-warn' }[journal.status])= journal.status
        if journal.datesubmitted
          p.meta Submitted #{journal.datesubmitted}
        if journal.notes
          p.note= journal.notes
        if journal.file_path
          p
            a(href=`/ojt-dashboard/journal-file/${journal.journalid}`) View journal file
        form.form(action=`/ojt-dashboard/journals-review/${internId}` method='POST')
          input(type='hidden' name='csrf_token' value=csrfToken)
          input(type='hidden' name='journalid' value=journal.journalid)
          .field
            label(for=`remark-${journal.journalid}`) Your remark
            textarea.input(id=`remark-${journal.journalid}` name='remark' rows='2')= journal.remark
          .btn-row
            button.btn.btn-create.btn-sm(type='submit' name='decision' value='APPROVED') Approve
            button.btn.btn-reject.btn-sm(type='submit' name='decision' value='REJECTED') Reject
