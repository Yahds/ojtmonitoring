extends ../../layouts/main

block content
  p.crumb
    a(href='/adviser/announcements') Announcements
    |  / Edit
  h1.page-title Edit announcement

  section.card.card-pad
    form.form(action=`/adviser/announcements/${announcement.announcementid}/edit` method='POST')
      input(type='hidden' name='csrf_token' value=csrfToken)
      include ../../partials/announcement-fields
      p.muted Interns will see that this post was edited.
      .btn-row
        button.btn.btn-create(type='submit') Save changes
        a.btn.btn-outline(href='/adviser/announcements') Cancel
