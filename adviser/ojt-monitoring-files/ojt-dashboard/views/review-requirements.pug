extends ../../layouts/main

block content
  p.crumb
    a(href='/ojt-dashboard/enroll') Interns
    |  / Requirements
  h1.page-title
    | Requirements
    if assignedRequirements.length
      |  · #{assignedRequirements[0].studentName}

  section.card
    if assignedRequirements.length === 0
      .empty
        b No requirements found
        | This intern has no requirements yet, or is not one of your interns.
    each req in assignedRequirements
      article.item
        .item-head
          h3= req.requirementname
          span.tag(class={ APPROVED: 'tag-ok', REJECTED: 'tag-bad', SUBMITTED: 'tag-warn' }[req.status])= req.status
        if req.datesubmitted
          p.meta Submitted #{req.datesubmitted}
        if req.intern_remarks
          p.note
            b Intern:
            |  #{req.intern_remarks}
        if req.file_path
          p
            a(href=`/ojt-dashboard/requirement-file/${internId}/${req.reqid}`) View submitted file
        if req.status === 'PENDING'
          p.meta Waiting for the intern to submit.
        else
          form.form(action=`/ojt-dashboard/requirements-review/${internId}` method='POST')
            input(type='hidden' name='csrf_token' value=csrfToken)
            input(type='hidden' name='reqid' value=req.reqid)
            .field
              label(for=`remarks-${req.reqid}`) Your remark
              textarea.input(id=`remarks-${req.reqid}` name='remarks' rows='2')= req.remarks
            .btn-row
              button.btn.btn-create.btn-sm(type='submit' name='decision' value='APPROVED') Approve
              button.btn.btn-reject.btn-sm(type='submit' name='decision' value='REJECTED') Reject
