mixin internHeader(intern, tab)
  - const internStatus = statusOf('intern', intern.status)
  - const base = `/adviser/interns/${intern.internid}`
  p.crumb
    a(href='/adviser/interns') ← Interns
  section.card.intern-head
    div
      h1= intern.studentName
      p.meta #{intern.studentID} · #{intern.course} · Section #{intern.classcode}#{intern.companyname ? ` · ${intern.companyname}` : ''}
    .right
      span.tag(class=internStatus.tag)= intern.status === 'ACTIVE' && intern.deployedLabel ? `Deployed since ${intern.deployedLabel}` : internStatus.label
      if intern.deployedOn
        .hours
          .bar
            span(style=`width: ${Math.min(100, Math.round(intern.approvedHours / intern.target_hours * 100))}%`)
          span.num #{intern.approvedHours} / #{intern.target_hours} hours
      if intern.status !== 'FINISHED'
        details.more-menu
          summary(aria-label='More actions') ⋯
          .menu
            if intern.status === 'ENROLLED' || intern.status === 'PENDING'
              a(href=`${base}/placement`)= intern.companyname ? 'Change placement' : 'Record placement'
            if intern.status === 'PENDING'
              a(href=`${base}/deploy`) Deploy
            if intern.status === 'ACTIVE'
              a(href=`${base}/finish`) Mark as finished
            if intern.status === 'WITHDRAWN'
              form(action=`${base}/undo-withdraw` method='POST')
                input(type='hidden' name='csrf_token' value=csrfToken)
                button(type='submit') Undo withdraw
            else
              a.danger(href=`${base}/withdraw`) Withdraw
  nav.tabs(aria-label='Intern pages')
    each item in [['requirements', 'Requirements', intern.waitingRequirements], ['weekly-reports', 'Weekly reports', intern.waitingWeekly], ['journals', 'Journals', intern.waitingJournals]]
      a(href=`${base}/${item[0]}` aria-current=(tab === item[0] ? 'page' : undefined))
        = item[1]
        if item[2]
          span.count= item[2]
          span.sr-only  to review
