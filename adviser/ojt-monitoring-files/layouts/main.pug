doctype html
html(lang='en')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1')
    title #{title ? title + ' · ' : ''}SLU OJT Portal
    link(rel='preconnect' href='https://fonts.googleapis.com')
    link(rel='preconnect' href='https://fonts.gstatic.com' crossorigin)
    link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;600;700;800&display=swap')
    link(rel='stylesheet' href='/assets/css/app.css')
  body
    block page
      a.skip-link(href='#main') Skip to content
      include ../partials/navbar
      if user
        .shell
          include ../partials/sidebar
          main.content#main
            include ../partials/flash
            block content
        dialog#idle-warning.idle-dialog(aria-labelledby='idle-warning-title')
          h2#idle-warning-title Are you still there?
          p You will be logged out in 2 minutes due to inactivity.
          .btn-row
            button.btn.btn-primary(type='button' data-stay-logged-in) Stay logged in
        script(src='/assets/js/idle-warning.js' defer)
      else
        main.content#main
          include ../partials/flash
          block content
