extends ../layouts/main

block page
  .login-wrap
    section.login-art
      .brand
        img(src='/assets/img/slu-logo.png' alt='' width='40')
        | SLU OJT Portal
      div
        p.art-title On-the-job training, in one place.
        p Submit and review requirements, weekly reports and journals for SAMCIS practicum.
      p.art-foot Saint Louis University · School of Accountancy, Management, Computing and Information Studies

    main.login-form#main
      img.login-logo(src='/assets/img/slu-logo.png' alt='Saint Louis University')
      h1 Log in
      p.lead For advisers and the department head
      include ../partials/flash
      if error
        .flash.flash-error(role='alert')= error
      form.form(action='/ojt-login-page' method='POST')
        input(type='hidden' name='csrf_token' value=csrfToken)
        .field
          label(for='email') Email
          input.input#email(type='email' name='adviserEmail' value=email autocomplete='username' required autofocus)
        .field
          label(for='password') Password
          .pw
            input.input#password(type='password' name='password' autocomplete='current-password' required aria-invalid=(error ? 'true' : undefined))
            button.btn.btn-outline.btn-sm(type='button' data-toggle-password='password' aria-pressed='false') Show
        button.btn.btn-primary.big-btn(type='submit') Log in

  script(src='/assets/js/show-password.js' defer)
