extends ../../layouts/main

block content
  h1.page-title Advisers

  section.card
    .card-head
      h2 Advisers in your department
      a.btn.btn-create.btn-sm(href='#add-adviser') Add adviser
    if advisers.length === 0
      .empty
        b No advisers yet
        | Add the first adviser with the form below.
    else
      .table-wrap
        table
          thead
            tr
              th Name
              th Email
          tbody
            each a in advisers
              tr
                td= a.adviserName
                td= a.adviserEmail

  section.card.card-pad#add-adviser
    h2.section-title Add an adviser
    form.form(action='/ojt-admin/advisers' method='POST')
      input(type='hidden' name='csrf_token' value=csrfToken)
      .field
        label(for='name') Full name
        input.input#name(type='text' name='name' placeholder='Cruz, Maria' required)
        span.help Last name, then first name.
      .field
        label(for='email') Email
        input.input#email(type='email' name='email' autocomplete='off' required)
      .field
        label(for='password') Temporary password
        input.input#password(type='text' name='password' autocomplete='off' required)
        span.help The adviser logs in with this. Share it with them privately.
      .btn-row
        button.btn.btn-create(type='submit') Add adviser
