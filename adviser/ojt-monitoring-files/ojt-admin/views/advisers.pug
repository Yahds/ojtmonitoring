extends ../../layouts/main

block content
  h1.page-title Advisers

  section.card
    .card-head
      h2 Advisers in your department
      a.btn.btn-create.btn-sm(href='/adviser/admin/advisers/new') Add adviser
    if advisers.length === 0
      .empty
        b No advisers yet
        | Add the first adviser with the Add adviser button.
    else
      .table-wrap
        table
          thead
            tr
              th Name
              th Email
          tbody
            each a in advisers
              tr
                td= a.adviserName
                td= a.adviserEmail